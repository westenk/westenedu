      for(const e of bEn)if(!e.dead&&Math.hypot(mp.x-e.g.position.x,mp.z-e.g.position.z)<.8*e.k.sc&&mp.y<2*e.k.sc){dmgE(e,e.k.boss?80:120,false);e.stun=Math.max(e.stun,.6);snd(900,.08,'triangle',.06);dead=true;break}
    }
    if(dead){B.s.remove(m);bPj.splice(i,1)}
  }
  for(let i=bFx.length-1;i>=0;i--){const f=bFx[i];f.t-=dt;if(f.fn)f.fn(f.o,1-Math.max(f.t,0)/f.t0);if(f.t<=0){B.s.remove(f.o);f.o.geometry.dispose();if(f.fn)f.o.material.dispose();bFx.splice(i,1)}}
  if(!bRun)return;
  bRegen+=dt;if(bRegen>6&&bHp<100){bHp=Math.min(100,bHp+4*dt);hud()}
  $('#bst').style.width=bSt+'%';
  const bo=bEn.find(e=>e.k.boss&&!e.dead);$('#bbo').hidden=!bo;if(bo){$('#bbn').textContent=bo.k.n;$('#bbh').style.width=Math.max(0,bo.hp/bo.mhp*100)+'%'}
  if(bMsg>0){bMsg-=dt;if(bMsg<=0)$('#bm2').textContent=''}
  B.sun.position.set(bP.x+30,50,bP.z+20);B.sun.target.position.set(bP.x,0,bP.z);
  B.r.render(B.s,B.c);
}
function bOver(){
  bStop();const nb=bScore>(best.blaster||0);if(nb){best.blaster=bScore;save();showBest()}
  $('#bm2').textContent='Game over';bMsg=0;
  $('#bmsg').textContent=nb?`You scored ${bScore} and reached wave ${bWave}. New best!`:`You scored ${bScore} and reached wave ${bWave}. Press Start to retry.`;
  B.r.render(B.s,B.c);
}
function bStop(){bRun=false;cancelAnimationFrame(braf);bk={};bLook=null;bFire=false;bAds=false;bPn=-1;$('#bstart').textContent='Start';if(document.pointerLockElement)document.exitPointerLock()}
function bStart(sand){
  if(!B){try{bInit()}catch(e){$('#bmsg').textContent='3D graphics aren\u2019t available in this browser.';B=null;return}}
  bStop();closePanel();bSand=!!sand;
  bEn.forEach(e=>{B.s.remove(e.g);if(e.tg)B.s.remove(e.tg)});bEn=[];bPj.forEach(q=>B.s.remove(q.m));bPj=[];bFx.forEach(f=>B.s.remove(f.o));bFx=[];
  buildWorld();
  bScore=0;bHp=100;bP={x:0,z:20};for(let z=20;z>-30;z-=3)if(free(0,z)){bP={x:0,z};break}
  bV={x:0,z:0};bY=0;bVy=0;bYaw=0;bPit=0;bSt=100;bWave=0;bQ=[];bSpT=1;bAmmo=12;bRes=72;bRel=0;bSl=0;bFov=ST.fov;bPcd=0;bGod=false;bInf=bSand;bFreeze=false;bSty='standard';
  bPaused=!coarse&&!bNoLock;hud();bRun=true;bT=performance.now();
  $('#bm2').textContent=bPaused?'Click the view to start':'';bMsg=0;
  $('#bstart').textContent='Restart';
  $('#bmsg').textContent=bSand?'Sandbox: keys 1-6 spawn enemies (Grunt, Runner, Gunman, Brute, Warden, Phantom), 0 clears, M opens the sandbox menu.':'WASD move, Shift sprint, C crouch, Space jump, right-click aim, R reload, F punch and parry, P fullscreen, M menu.';
  if(bSand)sbAct('none');
  braf=requestAnimationFrame(bLoop);
}
$('#bstart').onclick=()=>bStart(false);$('#bsand').onclick=()=>bStart(true);$('#bset').onclick=openPanel;
const KM={KeyW:'f',KeyS:'b',KeyA:'l',KeyD:'r',ArrowUp:'f',ArrowDown:'b',ArrowLeft:'tl',ArrowRight:'tr',ShiftLeft:'sp',ShiftRight:'sp',KeyC:'c',Space:'j'},SK=['grunt','runner','gunman','brute','warden','phantom'];
addEventListener('keydown',e=>{
  if(cur!=='blaster'||!bRun||/INPUT|SELECT/.test(e.target.tagName))return;
  if(e.code==='KeyM'){bPanel?closePanel():openPanel();return}
  if(bPanel)return;
  if(e.code==='KeyR'){reload();return}
  if(e.code==='KeyF'){punch();return}
  if(e.code==='KeyP'){toggleFs();return}
  if(bSand){const n=+e.code.replace('Digit','');if(n>=1&&n<=6){sbAct(SK[n-1]);return}if(e.code==='Digit0'){sbAct('clear');return}}
  const k=KM[e.code];if(k){bk[k]=1;e.preventDefault()}
});
addEventListener('keyup',e=>{const k=KM[e.code];if(k)bk[k]=0});
addEventListener('blur',()=>{bk={}});
bindPanel();

/* Reaction */
const rb=$('#react');let rs='idle',rt,rto;
rb.onclick=()=>{
  if(rs==='idle'){
    rs='wait';rb.className='wait';rb.textContent='Wait for green…';$('#rmsg').textContent='';
    rto=setTimeout(()=>{rs='go';rb.className='go';rb.textContent='Click!';rt=performance.now()},1000+Math.random()*2500);
  }else if(rs==='wait'){
    clearTimeout(rto);rs='idle';rb.className='';rb.textContent='Click to try again';$('#rmsg').textContent='Too soon. Wait for green.';
  }else{
    const ms=Math.round(performance.now()-rt);rs='idle';rb.className='';rb.textContent='Click to try again';
    $('#rl').textContent=ms+' ms';
    if(!best.reaction||ms<best.reaction){best.reaction=ms;save();showBest();$('#rmsg').textContent='New best!'}else $('#rmsg').textContent='Nice. Try to beat your best.';
  }
};
</script>
</body>
