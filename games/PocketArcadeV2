<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pocket Arcade</title>
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root{--bg:#FFD23F;--ink:#1B1B3A;--card:#FFF6D6;--pink:#FF4D6D;--sky:#3BC9DB;--dark:#1B1B3A;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1B1B3A;--ink:#FFE9A8;--card:#2A2A57;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1B1B3A;--ink:#FFE9A8;--card:#2A2A57;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.05rem/1.55 "DM Sans",system-ui,sans-serif}
h1,h2,h3,.logo{font-family:Bungee,Impact,sans-serif;font-weight:400;line-height:1.05;margin:0}
a{color:inherit}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px}
header .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:18px;padding-bottom:18px;gap:16px;flex-wrap:wrap}
.logo{font-size:1.5rem;text-decoration:none}
nav{display:flex;gap:20px;font-weight:700}
nav a{text-decoration:none;border-bottom:3px solid transparent}
nav a:hover,nav a:focus-visible{border-color:var(--pink)}
:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
.hero{display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:start;padding:24px 0 64px}
.hero h1{font-size:clamp(2.4rem,6vw,4.4rem);margin-bottom:18px}
.hero p{max-width:34ch;margin:0 0 20px}
.btn{font:700 1rem "DM Sans",sans-serif;background:var(--pink);color:var(--dark);border:3px solid var(--ink);border-radius:12px;padding:10px 18px;cursor:pointer;box-shadow:4px 4px 0 var(--ink);text-decoration:none;display:inline-block}
.btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--ink)}
.btn.sky{background:var(--sky)}
.cab{background:var(--card);border:4px solid var(--ink);border-radius:22px;box-shadow:8px 8px 0 var(--ink);padding:14px}
.tabs{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.tabs button{font:700 .95rem "DM Sans",sans-serif;background:transparent;color:var(--ink);border:3px solid var(--ink);border-radius:999px;padding:6px 14px;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--sky);color:var(--dark)}
.screen{background:var(--dark);border-radius:12px;padding:10px;display:grid;justify-items:center;gap:10px;min-height:420px;align-content:start}
.hud{display:flex;justify-content:space-between;width:100%;color:#FFE9A8;font-weight:700}
#snake{width:100%;max-width:360px;aspect-ratio:1;background:#262651;border-radius:8px;touch-action:none}
.dpad{display:grid;grid-template-columns:repeat(3,48px);gap:6px}
.dpad button{height:44px;border-radius:10px;border:2px solid #FFE9A8;background:transparent;color:#FFE9A8;font-size:1.1rem;cursor:pointer}
.dpad .u{grid-column:2}.dpad .l{grid-column:1;grid-row:2}.dpad .d{grid-column:2;grid-row:2}.dpad .r{grid-column:3;grid-row:2}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;width:100%;max-width:340px}
.grid4 button{aspect-ratio:1;font-size:2rem;border-radius:12px;border:3px solid #FFE9A8;background:#262651;color:inherit;cursor:pointer}
.grid4 button.up{background:#FFE9A8}
.grid4 button.done{background:var(--sky);border-color:var(--sky)}
#react{width:100%;max-width:340px;height:240px;border-radius:14px;border:4px solid #FFE9A8;background:#262651;color:#FFE9A8;font:400 1.5rem Bungee,Impact,sans-serif;cursor:pointer;padding:12px}
#react.wait{background:var(--pink);color:var(--dark)}
#react.go{background:#46D37F;color:var(--dark)}
.note{color:#FFE9A8;margin:0;text-align:center;min-height:1.5em}
#bwrap{position:relative;width:100%;aspect-ratio:4/3;background:#000;border-radius:8px}
#bwrap canvas{display:block;width:100%;aspect-ratio:4/3;border-radius:8px;touch-action:none}
#bwrap:fullscreen,#bwrap.fs{width:100vw;height:100vh;border-radius:0}
#bwrap.fs{position:fixed;inset:0;z-index:999}
#bwrap:fullscreen canvas,#bwrap.fs canvas{height:100%;aspect-ratio:auto;border-radius:0}
#bov{position:absolute;inset:0;pointer-events:none;border-radius:8px;transition:box-shadow .15s;color:#fff;font:700 .9rem "DM Sans",sans-serif;text-shadow:0 1px 3px #000}
#bov i{position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px;border:2px solid var(--xh,#FFE9A8);border-radius:50%;transition:.08s}
#bov.hit i{border-color:#FF4D6D;transform:scale(1.6)}
#bov .hl{position:absolute;left:10px;top:8px}
#bov .ha{position:absolute;right:12px;bottom:8px;font:400 1.5rem Bungee,Impact,sans-serif}
#bov .ha small{font:700 .85rem "DM Sans",sans-serif}
#bov .hb{position:absolute;left:10px;bottom:10px;width:34%;display:grid;gap:4px}
.bar{height:8px;background:#0008;border-radius:4px;overflow:hidden}
.bar u{display:block;height:100%;background:#46D37F;width:100%}
.bar.s u{background:#3BC9DB}
#bov .hm{position:absolute;left:0;right:0;top:22%;text-align:center;font:400 1.4rem Bungee,Impact,sans-serif}
#bov .tr{position:absolute;right:8px;top:8px;display:flex;gap:6px;pointer-events:auto}
#bov .tr button{font:700 .8rem "DM Sans",sans-serif;background:var(--sky);color:var(--dark);border:2px solid var(--dark);border-radius:8px;padding:4px 8px;cursor:pointer}
#bov .hl small{display:block;font-weight:600;opacity:.85}
#bbo{position:absolute;left:22%;right:22%;top:40px;text-align:center;font:400 .95rem Bungee,Impact,sans-serif}
.bar.b{height:10px;margin-top:3px}.bar.b u{background:#FF4D6D}
#bidle{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:20px;color:#FFE9A8;font:400 1.3rem Bungee,Impact,sans-serif}
#bsp{position:absolute;inset:0;z-index:5;background:rgba(15,15,40,.94);color:#FFE9A8;padding:14px;overflow:auto;font:600 .85rem "DM Sans",sans-serif;display:flex;flex-direction:column;gap:8px;border-radius:8px}
#bsp h3{font-size:1.15rem}
#bsp label{display:flex;justify-content:space-between;gap:10px;align-items:center}
#bsp input[type=range],#bsp select,#bsp input[type=text],#bsp input[type=color]{width:52%}
#bsp select,#bsp input[type=text]{padding:3px;border-radius:6px;border:2px solid #FFE9A8;background:#262651;color:#FFE9A8}
#bsp small{opacity:.8;font-weight:400}
#bsb{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
#bsb button{font:700 .75rem "DM Sans",sans-serif;padding:6px;border-radius:8px;border:2px solid #FFE9A8;background:transparent;color:#FFE9A8;cursor:pointer}
#bsb button:hover{background:#FFE9A822}
#bov .dpad,#bacts{pointer-events:auto;position:absolute;bottom:32px}
#bov .dpad{left:8px}
#bacts{right:8px;bottom:48px;display:grid;grid-template-columns:repeat(3,52px);gap:6px}
#bacts button{height:44px;border-radius:10px;border:2px solid #FFE9A8;background:#0006;color:#FFE9A8;font:700 .75rem "DM Sans",sans-serif}
@media (hover:hover) and (pointer:fine){#bpad,#bacts{display:none}}
[hidden]{display:none!important}
section{padding:56px 0}
section h2{font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:24px}
.shelf{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.card{border:4px solid var(--ink);border-radius:20px;padding:22px;box-shadow:6px 6px 0 var(--ink);display:flex;flex-direction:column;gap:12px;align-items:flex-start;color:var(--dark)}
.card h3{font-size:1.6rem}
.card p{margin:0}
.c1{background:var(--pink)}.c2{background:var(--sky)}.c3{background:#FFF6D6}
.scores{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
.score{background:var(--card);border:4px solid var(--ink);border-radius:20px;padding:18px}
.score b{font:400 2.4rem Bungee,Impact,sans-serif;display:block}
footer{padding:32px 0 48px;font-size:.95rem}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
@media(max-width:820px){.hero,.shelf,.scores{grid-template-columns:1fr}.screen{min-height:0}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn:active{transform:none}}
</style>
</head>
<body>
<header><div class="wrap"><a class="logo" href="#top">Pocket Arcade</a>
<nav><a href="#shelf">Games</a><a href="#scores">Best scores</a></nav></div></header>
<main id="top">
<div class="wrap hero">
 <div>
  <h1>Quick games. No downloads.</h1>
  <p>Four little games that start the moment you open the page. Play on a keyboard, a phone, or whatever’s nearby, and try to beat your own best.</p>
  <a class="btn" href="#play">Play now</a>
 </div>
 <div class="cab" id="play">
  <div class="tabs" role="tablist" aria-label="Choose a game">
   <button role="tab" aria-selected="true" data-g="snake">Snake</button>
   <button role="tab" aria-selected="false" data-g="memory">Memory</button>
   <button role="tab" aria-selected="false" data-g="reaction">Reaction</button>
   <button role="tab" aria-selected="false" data-g="blaster">Blaster 3D</button>
  </div>
  <div class="screen">
   <div id="p-snake" style="display:grid;gap:10px;justify-items:center;width:100%">
    <div class="hud"><span>Score <span id="sc">0</span></span><span>Best <span id="sb">0</span></span></div>
    <canvas id="snake" width="360" height="360" aria-label="Snake game board"></canvas>
    <p class="note" id="smsg">Press Start, then use arrow keys, WASD or swipe.</p>
    <div class="dpad" aria-label="On-screen controls"><button class="u" data-d="u" aria-label="Up">▲</button><button class="l" data-d="l" aria-label="Left">◀</button><button class="d" data-d="d" aria-label="Down">▼</button><button class="r" data-d="r" aria-label="Right">▶</button></div>
    <button class="btn" id="sstart">Start</button>
   </div>
   <div id="p-memory" hidden style="display:grid;gap:10px;justify-items:center;width:100%">
    <div class="hud"><span>Moves <span id="mm">0</span></span><span>Best <span id="mb">–</span></span></div>
    <div class="grid4" id="mgrid"></div>
    <p class="note" id="mmsg">Flip two cards to find a match.</p>
    <button class="btn sky" id="mreset">New game</button>
   </div>
   <div id="p-reaction" hidden style="display:grid;gap:10px;justify-items:center;width:100%">
    <div class="hud"><span>Last <span id="rl">–</span></span><span>Best <span id="rb">–</span></span></div>
    <button id="react">Click to start</button>
    <p class="note" id="rmsg">Wait for green, then click as fast as you can.</p>
   </div>
   <div id="p-blaster" hidden style="display:grid;gap:10px;justify-items:center;width:100%">
    <div class="hud"><span>Score <span id="bs">0</span></span><span>Health <span id="bl">100</span></span><span>Best <span id="bb">0</span></span></div>
    <div id="bwrap"><div id="bidle">Choose Start or Sandbox below</div>
    <div id="bsp" hidden>
     <h3>Settings</h3>
     <label>Mouse sensitivity <input id="s-sens" type="range" min=".4" max="2.5" step=".1"></label>
     <label>Field of view <input id="s-fov" type="range" min="60" max="100" step="1"></label>
     <label>Volume <input id="s-vol" type="range" min="0" max="1" step=".05"></label>
     <label>Difficulty <select id="s-diff"><option value="0">Easy</option><option value="1">Normal</option><option value="2">Hard</option></select></label>
     <label>Crosshair color <input id="s-xh" type="color"></label>
     <label>Map seed <input id="s-seed" type="text" placeholder="random"></label>
     <label>Invert Y <input id="s-inv" type="checkbox"></label>
     <label>Head bob <input id="s-bob" type="checkbox"></label>
     <label>Shadows <input id="s-sh" type="checkbox"></label>
     <small>A seed rebuilds the same city next time you start. Leave it empty for a random one.</small>
     <div id="bsb" hidden>
      <button data-sp="grunt">Grunt</button><button data-sp="runner">Runner</button><button data-sp="gunman">Gunman</button>
      <button data-sp="brute">Brute</button><button data-sp="warden">Warden (boss)</button><button data-sp="phantom">Phantom (boss)</button>
      <button data-sp="clear">Clear enemies</button><button data-sp="heal">Heal</button><button data-sp="map">New map</button>
      <button data-sp="god">God mode: off</button><button data-sp="ammo">Infinite ammo: on</button><button data-sp="freeze">Freeze AI: off</button>
     </div>
     <button class="btn" id="s-close">Resume</button>
    </div></div>
    <p class="note" id="bmsg">Press Start, then click the game view to lock your mouse. Fullscreen button is in its top corner.</p>
    
    <button class="btn" id="bstart">Start</button> <button class="btn sky" id="bsand">Sandbox</button> <button class="btn" id="bset">Settings</button>
   </div>
  </div>
 </div>
</div>

<section id="shelf"><div class="wrap">
 <h2>The shelf</h2>
 <div class="shelf">
  <div class="card c1"><h3>Snake</h3><p>Eat, grow, and don’t hit the wall or yourself. The snake speeds up with every bite.</p><button class="btn" data-play="snake">Play Snake</button></div>
  <div class="card c2"><h3>Memory</h3><p>Match eight pairs in as few moves as you can.</p><button class="btn" data-play="memory">Play Memory</button></div>
  <div class="card c3"><h3>Reaction</h3><p>How fast can you click when the box turns green?</p><button class="btn sky" data-play="reaction">Play Reaction</button></div>
  <div class="card" style="background:#46D37F"><h3>Blaster 3D</h3><p>Fight through a city street with a pistol: sprint, slide, aim down sights and reload.</p><button class="btn" data-play="blaster">Play Blaster</button></div>
 </div>
</div></section>

<section id="scores"><div class="wrap">
 <h2>Your best scores</h2>
 <div class="scores">
  <div class="score">Snake<b id="t-snake">–</b>apples eaten</div>
  <div class="score">Memory<b id="t-memory">–</b>fewest moves</div>
  <div class="score">Reaction<b id="t-reaction">–</b>fastest click</div>
  <div class="score">Blaster 3D<b id="t-blaster">–</b>points scored</div>
 </div>
 <p>Scores are saved in this browser only.</p>
</div></section>
</main>
<footer><div class="wrap"><span>Pocket Arcade</span><span>Made for short breaks.</span></div></footer>

<script>
const $=s=>document.querySelector(s);
let best={};
try{best=JSON.parse(localStorage.getItem('pa-best')||'{}')||{}}catch(e){best={}}
function save(){try{localStorage.setItem('pa-best',JSON.stringify(best))}catch(e){}}
function showBest(){
  $('#sb').textContent=best.snake||0;$('#t-snake').textContent=best.snake??'–';
  $('#mb').textContent=best.memory??'–';$('#t-memory').textContent=best.memory??'–';
  const r=best.reaction?best.reaction+' ms':'–';$('#rb').textContent=r;$('#t-reaction').textContent=r;
  $('#bb').textContent=best.blaster||0;$('#t-blaster').textContent=best.blaster??'–';
}
showBest();

/* Tabs */
let cur='snake';
function openGame(g){
  cur=g;if(g!=='snake')sStop(true);if(g!=='blaster')bStop();
  document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.g===g));
  ['snake','memory','reaction','blaster'].forEach(k=>$('#p-'+k).hidden=k!==g);
}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>openGame(b.dataset.g));
document.querySelectorAll('[data-play]').forEach(b=>b.onclick=()=>{openGame(b.dataset.play);$('#play').scrollIntoView({behavior:'smooth',block:'center'})});

/* Snake */
const cv=$('#snake'),cx=cv.getContext('2d'),N=18,S=20;
let sn,dir,nd,food,sc,timer,running=false;
const col=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();
function place(){do{food={x:Math.floor(Math.random()*N),y:Math.floor(Math.random()*N)}}while(sn.some(p=>p.x===food.x&&p.y===food.y))}
function sDraw(){
  cx.clearRect(0,0,360,360);
  cx.fillStyle='#FF4D6D';cx.beginPath();cx.arc(food.x*S+10,food.y*S+10,8,0,7);cx.fill();
  sn.forEach((p,i)=>{cx.fillStyle=i?'#3BC9DB':'#FFD23F';cx.fillRect(p.x*S+1,p.y*S+1,S-2,S-2)});
}
function sReset(){sn=[{x:9,y:9},{x:8,y:9},{x:7,y:9}];dir=nd={x:1,y:0};sc=0;$('#sc').textContent=0;place();sDraw()}
function sStop(quiet){clearInterval(timer);running=false;$('#sstart').textContent='Start';if(quiet)return}
function tick(){
  dir=nd;const h={x:sn[0].x+dir.x,y:sn[0].y+dir.y};
  if(h.x<0||h.y<0||h.x>=N||h.y>=N||sn.some(p=>p.x===h.x&&p.y===h.y)){
    sStop();
    const nb=sc>(best.snake||0);if(nb){best.snake=sc;save();showBest()}
    $('#smsg').textContent=nb?`Game over. New best: ${sc}!`:`Game over. You ate ${sc}. Press Start to retry.`;return}
  sn.unshift(h);
  if(h.x===food.x&&h.y===food.y){sc++;$('#sc').textContent=sc;place();clearInterval(timer);timer=setInterval(tick,Math.max(55,120-sc*3))}else sn.pop();
  sDraw();
}
function sStart(){sStop(true);sReset();running=true;$('#sstart').textContent='Restart';$('#smsg').textContent='Go!';timer=setInterval(tick,120)}
$('#sstart').onclick=sStart;
const D={u:{x:0,y:-1},d:{x:0,y:1},l:{x:-1,y:0},r:{x:1,y:0}};
function turn(k){const v=D[k];if(!running||(v.x===-dir.x&&v.y===-dir.y))return;nd=v}
document.querySelectorAll('#p-snake .dpad button').forEach(b=>b.onclick=()=>turn(b.dataset.d));
addEventListener('keydown',e=>{
  if(cur!=='snake')return;
  const m={ArrowUp:'u',ArrowDown:'d',ArrowLeft:'l',ArrowRight:'r',w:'u',s:'d',a:'l',d:'r'}[e.key];
  if(m){if(running)e.preventDefault();turn(m)}
});
let t0;
cv.addEventListener('touchstart',e=>{t0=e.touches[0]},{passive:true});
cv.addEventListener('touchend',e=>{
  if(!t0)return;const t=e.changedTouches[0],dx=t.clientX-t0.clientX,dy=t.clientY-t0.clientY;
  if(Math.max(Math.abs(dx),Math.abs(dy))<20)return;
  turn(Math.abs(dx)>Math.abs(dy)?(dx>0?'r':'l'):(dy>0?'d':'u'));
});
sReset();

/* Memory */
const EM=['🚀','👾','🍄','⭐','🎲','🧩','🔥','🐙'];
let open=[],moves=0,lock=false,found=0;
function mNew(){
  const deck=[...EM,...EM].sort(()=>Math.random()-.5);
  open=[];moves=0;lock=false;found=0;$('#mm').textContent=0;$('#mmsg').textContent='Flip two cards to find a match.';
  const g=$('#mgrid');g.innerHTML='';
  deck.forEach(e=>{
    const b=document.createElement('button');b.textContent='?';b.setAttribute('aria-label','Hidden card');
    b.onclick=()=>{
      if(lock||b.classList.contains('up')||b.classList.contains('done'))return;
      b.classList.add('up');b.textContent=e;open.push({b,e});
      if(open.length===2){
        moves++;$('#mm').textContent=moves;lock=true;
        const [x,y]=open;
        if(x.e===y.e){x.b.classList.replace('up','done');y.b.classList.replace('up','done');open=[];lock=false;found++;
          if(found===EM.length){const nb=!best.memory||moves<best.memory;if(nb){best.memory=moves;save();showBest()}
            $('#mmsg').textContent=nb?`Done in ${moves} moves. New best!`:`Done in ${moves} moves.`}}
        else setTimeout(()=>{open.forEach(o=>{o.b.classList.remove('up');o.b.textContent='?'});open=[];lock=false},700);
      }
    };
    g.appendChild(b);
  });
}
$('#mreset').onclick=mNew;mNew();

/* Blaster 3D */
let B=null,bRun=false,braf,bScore=0,bHp=100,bEn=[],bPj=[],bT=0,bFx=[],bP={x:0,z:20},bV={x:0,z:0},bY=0,bVy=0,bYaw=0,bPit=0,bk={},bLook=null,bNoLock=false,bPaused=false,bWave=0,bQ=[],bSpT=0,bAds=false,bFire=false,bCd=0,bAmmo=12,bRes=72,bRel=0,bKick=0,bSl=0,bSlD={x:0,z:0},bSt=100,bEx=false,bEye=1.7,bBob=0,bFov=74,bMsg=0,bRegen=0,bFlT=0,bDip=0,bCp=false,bR=[],bC=[],bWorld=[],bSand=false,bGod=false,bInf=false,bFreeze=false,bPn=-1,bPcd=0,bPhit=false,bHs=0,bShake=0,bSty='standard',bPack=null,bSeed=0,bPanel=false,rng=Math.random;
const coarse=matchMedia('(pointer:coarse)').matches,$c=(v,a,b)=>Math.max(a,Math.min(b,v)),R=n=>Math.floor(rng()*n);
const mul=a=>()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
/* Settings */
let ST=Object.assign({sens:1,fov:74,vol:.7,diff:1,xh:'#FFE9A8',inv:0,bob:1,sh:1,seed:''},(()=>{try{return JSON.parse(localStorage.getItem('pa-set')||'{}')}catch(e){return{}}})());
